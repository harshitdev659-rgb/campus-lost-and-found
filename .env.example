# Database Configuration (SQLite for zero-config local/Render persistence, or PostgreSQL)
DATABASE_URL="file:./dev.db"

# Authentication & Session Security
JWT_SECRET="super-secret-campus-jwt-key-change-this-in-production-min32chars"
JWT_EXPIRES_IN="7d"

# Campus Domain Configuration (comma-separated domains allowed for student/faculty registration)
# In demo/flexible mode, you can add any institution or student email domain
ALLOWED_CAMPUS_DOMAINS="campus.edu,university.edu,college.edu,student.edu,iit.ac.in,nit.ac.in,gmail.com"

# Institutional Branding
NEXT_PUBLIC_APP_NAME="CampusFind - University Lost & Found"
NEXT_PUBLIC_CAMPUS_NAME="University Campus Central"

# Upload Limits
MAX_UPLOAD_SIZE_MB=5
